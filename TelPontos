package model;
public class Usuario {

    private int pontos;
    private int aguaMl;

    public void beberAgua(){

        aguaMl += 250;

        pontos += 2;
    }

    public int getPontos(){
        return pontos;
    }

    public int getAguaMl(){
        return aguaMl;
    }

    public double getLitros(){
        return aguaMl / 1000.0;
    }

    public void limparDados(){

        pontos = 0;

        aguaMl = 0;
    }

}
