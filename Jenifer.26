    private void bntCalcularActionPerformed(java.awt.event.ActionEvent evt) {                                            
        {
    try {
        usuario.peso = Double.parseDouble(txtPeso.getText());

        double meta = usuario.calcularMeta();
        double progresso = usuario.calcularProgresso();
        int pontos = usuario.calcularPontos();

        txtMeta.setText(meta + " ml");
        txtPontos.setText(pontos + "");

    } catch (NumberFormatException e) {
        javax.swing.JOptionPane.showMessageDialog(null, "Digite um peso válido!");
    }
    if (usuario.aguaConsumida >= 2000) {
    javax.swing.JOptionPane.showMessageDialog(null, "Parabéns! Você atingiu a meta diária 🎉");
}
}
        // TODO add your handling code here:
    }                                           

    private void btnPontosActionPerformed(java.awt.event.ActionEvent evt) {                                          

    TelaPontos tela = new TelaPontos();

    int pontos = usuario.calcularPontos();
    tela.mostrarPontos(pontos);

    tela.setVisible(true);
}
        // TODO add your handling code here:
    }                                         

