    private void bntAguaActionPerformed(java.awt.event.ActionEvent evt) {                                        
  usuario.aguaConsumida += 250;



double meta = usuario.calcularMeta();
int pontos = usuario.calcularPontos();

txtMeta.setText("Meta diária: " + meta + " ml");
txtPontos.setText(pontos + "");

double falta = 2000 - usuario.aguaConsumida;
       

if (falta <= 0) {
    txtProgresso.setText("Parabéns! Meta atingida!");
} else {
    txtProgresso.setText("Continue se hidratando!");
}
    
        // TODO add your handling code here:
    }                                       

    private void bntResetarActionPerformed(java.awt.event.ActionEvent evt) {                                           
{
    usuario.aguaConsumida = 0;

    txtMeta.setText("0 ml"); // se existir
    txtMeta.setText("");
    txtPontos.setText("");
}     
        
