    private void btnAguaActionPerformed(java.awt.event.ActionEvent evt) {                                        
    user.beberAgua();

   labelAgua.setText(
user.getAguaMl() + " ml / " + metaDiaria + " ml"
);

    labelPontos.setText(
    "Pontos: " + user.getPontos() + "/30"
    );

   // TEMA AZUL
   if(user.getPontos() >= 5){

    if(azulLiberado == false){

        JOptionPane.showMessageDialog(null,
        "Parabéns! Você desbloqueou o Tema Azul!");

        azulLiberado = true;
    }

}
   // TEMA ROXO
   if(user.getPontos() >= 10){

        if(roxoLiberado == false){

            JOptionPane.showMessageDialog(null,
            "Parabéns! Você desbloqueou o Tema Roxo!");

            roxoLiberado = true;
        }
    }

    // TEMA NEON
    if(user.getPontos() >= 20){

        if(neonLiberado == false){

            JOptionPane.showMessageDialog(null,
            "Parabéns! Você desbloqueou o Tema Neon!");

            neonLiberado = true;
        }
    }

    // TEMA GAMER
    if(user.getPontos() >= 30){

        if(gamerLiberado == false){

            JOptionPane.showMessageDialog(null,
            "Parabéns! Você desbloqueou o Tema Gamer!");

            gamerLiberado = true;
        }
    }

   // META DIÁRIA
if(metaDiaria > 0){

    if(user.getAguaMl() >= metaDiaria){

        if(metaMostrada == false){

            JOptionPane.showMessageDialog(null,
            "Parabéns! Você atingiu a meta diária!");

            metaMostrada = true;
        }
    }
}
